<% dummy_page_nav(title: "Install", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Install",
    subtitle: "Host-app setup for the mounted RecordingStudioInternationalization engine.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Add the gem",
    subtitle: "English works as soon as the engine is mounted. There is no migration.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      bin/rails generate recording_studio_internationalization:install
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "List the languages",
    subtitle: "The host names the languages. Each gem only ships English.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      RecordingStudioInternationalization.configure do |config|
        config.available_locales = {
          en: { name: "English" },
          fr: { name: "Français" }
        }
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Place the selector",
    subtitle: "Render it where people should change language. The gem does not add its own navigation.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :erb,
    code: <<~CODE
      <%%= recording_studio_language_selector %>
    CODE
  ) %>
</div>
