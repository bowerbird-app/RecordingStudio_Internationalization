<% dummy_page_nav(title: t("dummy.docs.install.title"), back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("dummy.docs.install.title"),
    subtitle: t("dummy.docs.install.subtitle"),
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: t("dummy.docs.install.add_gem.title"),
    subtitle: t("dummy.docs.install.add_gem.subtitle"),
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      bin/rails generate recording_studio_internationalization:install
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: t("dummy.docs.install.list_languages.title"),
    subtitle: t("dummy.docs.install.list_languages.subtitle"),
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      RecordingStudioInternationalization.configure do |config|
        config.available_locales = {
          en: { name: "English" },
          fr: { name: "Français" }
        }
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: t("dummy.docs.install.place_selector.title"),
    subtitle: t("dummy.docs.install.place_selector.subtitle"),
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :erb,
    code: "#{'<'}%= recording_studio_language_selector #{'%'}#{'>'}\n"
  ) %>
</div>
