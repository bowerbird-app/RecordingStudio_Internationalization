<% dummy_page_nav(title: t("dummy.docs.methods.title"), back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("dummy.docs.methods.title"),
    subtitle: t("dummy.docs.methods.subtitle"),
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: t("dummy.docs.methods.name"),
    subtitle: "RecordingStudio.recordable_name",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudio.recordable_name(page)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: t("dummy.docs.methods.type"),
    subtitle: "RecordingStudio.recordable_type_label",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudio.recordable_type_label(page)
      RecordingStudio.recordable_type_label("Page")
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    <%= t("dummy.docs.methods.hint") %>
  </p>
</div>
