<% dummy_page_nav(title: t("dummy.docs.recordable_types.title"), back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("dummy.docs.recordable_types.title"),
    subtitle: t("dummy.docs.recordable_types.subtitle"),
    variant: :h1
  ) %>

  <% if @recordable_types.any? %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @recordable_types.each do |recordable_type| %>
        <%= render FlatPack::List::Item.new(icon: :queue_list) do %>
          <div class="flex flex-col gap-1">
            <span><%= recordable_type.fetch(:label) %></span>
            <span class="text-sm text-(--surface-muted-content-color)">
              <%= recordable_type.fetch(:root) ? t("dummy.docs.recordable_types.kind.root") : t("dummy.docs.recordable_types.kind.child") %> •
              <%= t(
                "dummy.docs.recordable_types.allowed_parents",
                parents: recordable_type.fetch(:allowed_parent_types).presence&.join(", ") || t("dummy.docs.recordable_types.none")
              ) %> •
              <%= t("dummy.docs.recordable_types.recordings", count: recordable_type.fetch(:recordings_count)) %> •
              <%= t("dummy.docs.recordable_types.recordables", count: recordable_type.fetch(:recordables_count)) %>
            </span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)"><%= t("dummy.docs.recordable_types.empty") %></p>
  <% end %>
</div>
