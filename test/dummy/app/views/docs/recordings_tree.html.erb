<% dummy_page_nav(title: t("dummy.docs.recordings_tree.title"), back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("dummy.docs.recordings_tree.title"),
    subtitle: t("dummy.docs.recordings_tree.subtitle"),
    variant: :h1
  ) %>

  <% if @recording_tree.any? %>
    <%= render FlatPack::Tree::Component.new(compact: true) do |tree| %>
      <% @recording_tree.each do |node| %>
        <%= render partial: "recording_tree_node", locals: { parent_builder: tree, node: node } %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)"><%= t("dummy.docs.recordings_tree.empty") %></p>
  <% end %>
</div>
