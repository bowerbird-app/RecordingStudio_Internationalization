<% dummy_page_nav(title: t("dummy.home.title"), back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("dummy.home.title"),
    subtitle: t("dummy.home.subtitle"),
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: t("dummy.home.language.title"),
          subtitle: t("dummy.home.language.subtitle"),
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li><code>messages.inbox.title</code>: <%= t("recording_studio.messages.inbox.title") %></li>
          <li><code>messages.inbox.empty</code>: <%= t("recording_studio.messages.inbox.empty") %></li>
          <li><code>presskits.index.title</code>: <%= t("recording_studio.presskits.index.title") %></li>
        </ul>
      <% end %>

      <% card.footer do %>
        <%= recording_studio_language_selector %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: t("dummy.home.working.title"),
          subtitle: t("dummy.home.working.subtitle"),
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li><%= t("dummy.home.working.routes") %></li>
          <li><%= t("dummy.home.working.english") %></li>
          <li><%= t("dummy.home.working.tailwind") %></li>
          <li><%= t("dummy.home.working.dummy") %></li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: t("dummy.home.next.title"),
          subtitle: t("dummy.home.next.subtitle"),
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ol class="space-y-3 text-sm leading-6 list-decimal pl-5">
          <li><%= t("dummy.home.next.rename_html") %></li>
          <li><%= t("dummy.home.next.tables") %></li>
          <li><%= t("dummy.home.next.types") %></li>
          <li><%= t("dummy.home.next.dummy") %></li>
        </ol>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: t("dummy.home.flatpack.title"),
          subtitle: t("dummy.home.flatpack.subtitle"),
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          <%= t("dummy.home.flatpack.body") %>
        </p>
      <% end %>

      <% card.footer do %>
        <a href="https://github.com/bowerbird-app/flatpack"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-flex">
          <%= render FlatPack::Button::Component.new(
            text: t("dummy.home.flatpack.docs"),
            style: :primary,
            size: :md
          ) %>
        </a>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: t("dummy.home.install.title"),
          subtitle: t("dummy.home.install.subtitle"),
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li><%= t("dummy.home.install.add_gem_html") %></li>
          <li><%= t("dummy.home.install.generate_html") %></li>
          <li><%= t("dummy.home.install.missing_html") %></li>
          <li><%= t("dummy.home.install.tailwind_html") %></li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
